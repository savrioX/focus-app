{
  "version": 2,
  "builds": [
    { "src": "api/claude.js",           "use": "@vercel/node" },
    { "src": "api/create-checkout.js",  "use": "@vercel/node" },
    { "src": "api/customer-portal.js",  "use": "@vercel/node" },
    { "src": "api/stripe-webhook.js",   "use": "@vercel/node" },
    { "src": "api/test.js",             "use": "@vercel/node" },
    { "src": "*.html",                  "use": "@vercel/static" },
    { "src": "*.PNG",                   "use": "@vercel/static" },
    { "src": "*.png",                   "use": "@vercel/static" },
    { "src": "*.json",                  "use": "@vercel/static" },
    { "src": "*.js",                    "use": "@vercel/static" },
    { "src": "*.xml",                   "use": "@vercel/static" },
    { "src": "*.txt",                   "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/claude",           "dest": "/api/claude.js"          },
    { "src": "/api/create-checkout",  "dest": "/api/create-checkout.js" },
    { "src": "/api/customer-portal",  "dest": "/api/customer-portal.js" },
    { "src": "/api/stripe-webhook",   "dest": "/api/stripe-webhook.js"  },
    { "src": "/api/test",             "dest": "/api/test.js"            },
    { "src": "/sw.js", "dest": "/sw.js", "headers": { "Service-Worker-Allowed": "/" } },
    { "handle": "filesystem" },
    { "src": "/(.*)",                 "dest": "/$1.html"                }
  ]
}
