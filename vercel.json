{
  "version": 2,
  "builds": [
    { "src": "api/claude.js",                  "use": "@vercel/node" },
    { "src": "api/email-welcome.js",           "use": "@vercel/node" },
    { "src": "api/cron-streak-reminder.js",    "use": "@vercel/node" },
    { "src": "api/cron-weekly-digest.js",      "use": "@vercel/node" },
    { "src": "api/cron-daily-digest.js",         "use": "@vercel/node" },
    { "src": "api/cron-morning-briefing.js",    "use": "@vercel/node" },
    { "src": "api/brain.js",                  "use": "@vercel/node" },
    { "src": "api/apex-plan.js",             "use": "@vercel/node" },
    { "src": "api/onboarding-plan.js",      "use": "@vercel/node" },
    { "src": "*.html",                         "use": "@vercel/static" },
    { "src": "*.PNG",                          "use": "@vercel/static" },
    { "src": "*.png",                          "use": "@vercel/static" },
    { "src": "*.json",                         "use": "@vercel/static" },
    { "src": "*.js",                           "use": "@vercel/static" },
    { "src": "*.xml",                          "use": "@vercel/static" },
    { "src": "*.txt",                          "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/claude",                 "dest": "/api/claude.js"                 },
    { "src": "/api/email-welcome",          "dest": "/api/email-welcome.js"          },
    { "src": "/api/cron-streak-reminder",   "dest": "/api/cron-streak-reminder.js"   },
    { "src": "/api/cron-weekly-digest",      "dest": "/api/cron-weekly-digest.js"     },
    { "src": "/api/cron-daily-digest",         "dest": "/api/cron-daily-digest.js"        },
    { "src": "/api/cron-morning-briefing",    "dest": "/api/cron-morning-briefing.js"    },
    { "src": "/api/brain",                   "dest": "/api/brain.js"                   },
    { "src": "/api/apex-plan",              "dest": "/api/apex-plan.js"              },
    { "src": "/api/onboarding-plan",        "dest": "/api/onboarding-plan.js"        },
    { "src": "/sw.js", "dest": "/sw.js", "headers": { "Service-Worker-Allowed": "/" } },
    { "handle": "filesystem" },
    { "src": "/(.*)",                       "dest": "/$1.html"                       },
    { "handle": "error" },
    { "src": "/.*", "status": 404,          "dest": "/404.html"                      }
  ],
  "crons": [
    {
      "path": "/api/cron-streak-reminder",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron-weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron-daily-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron-morning-briefing",
      "schedule": "0 5 * * *"
    }
  ]
}
